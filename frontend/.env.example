VITE_API_BASE_URL=http://localhost:8000
VITE_DOC_ID=
VITE_USER_ID=

# Set true when embedding on agicent.com (widget only, no demo chrome)
VITE_EMBED_MODE=false

# Enable microphone input and listen controls
VITE_VOICE_ENABLED=true

# Max audio upload size in MB.
# MUST match backend VOICE_MAX_AUDIO_BYTES (default: 10MB = 10 * 1024 * 1024).
# If this is larger than the backend limit, uploads between the two values will
# pass frontend validation but fail with a 413 from the server.
VITE_VOICE_MAX_AUDIO_MB=10

# Host page mount element id (default: agicent-consultant-root)
VITE_MOUNT_ID=agicent-consultant-root
